@model MaSV_MyStore.Models.ViewModel.Cart
@if (Model.SimilarProducts != null && Model.SimilarProducts.Count > 0)
{
    <h3 class="section-title">Sản phẩm tương tự</h3>
    <div class="grid">
        @foreach (var p in Model.SimilarProducts)
        {
            <div class="p-card">
                <a href="@Url.Action("ProductDetail", "Home", new { id = p.ProductID })">
                    <img src="~/Content/images/products/@p.ProductImage" alt="@p.ProductName" />
                    <div class="p-price">@p.Price.ToString("N0") VND</div>
                    <div class="p-name">@p.ProductName</div>
                </a>
                @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                {
                    <input type="hidden" name="id" value="@p.ProductID" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="btn btn-blue block">Thêm vào giỏ hàng</button>
                }
            </div>
        }
    </div>
    <div class="pager">
        @Html.PagedListPager(Model.SimilarProducts, page => Url.Action("Index", "Cart", new { page = page }))
    </div>
}
