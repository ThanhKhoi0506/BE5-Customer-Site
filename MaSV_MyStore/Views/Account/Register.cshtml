@model RegisterVM
@{ ViewBag.Title = "Đăng ký tài khoản"; }
<div class="form-page">
    <h2>Đăng ký tài khoản</h2>
    @using (Html.BeginForm("Register", "Account", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-error" })
        <table class="form-table">
            <tr><td>@Html.LabelFor(m => m.Username)</td><td>@Html.TextBoxFor(m => m.Username)@Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-error" })</td></tr>
            <tr><td>@Html.LabelFor(m => m.Password)</td><td>@Html.PasswordFor(m => m.Password)@Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-error" })</td></tr>
            <tr><td>@Html.LabelFor(m => m.ConfirmPassword)</td><td>@Html.PasswordFor(m => m.ConfirmPassword)@Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-error" })</td></tr>
            <tr><td>@Html.LabelFor(m => m.CustomerName)</td><td>@Html.TextBoxFor(m => m.CustomerName)@Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-error" })</td></tr>
            <tr><td>@Html.LabelFor(m => m.CustomerPhone)</td><td>@Html.TextBoxFor(m => m.CustomerPhone)@Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-error" })</td></tr>
            <tr><td>@Html.LabelFor(m => m.CustomerEmail)</td><td>@Html.TextBoxFor(m => m.CustomerEmail)@Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-error" })</td></tr>
            <tr><td>@Html.LabelFor(m => m.CustomerAddress)</td><td>@Html.TextBoxFor(m => m.CustomerAddress)@Html.ValidationMessageFor(m => m.CustomerAddress, "", new { @class = "text-error" })</td></tr>
            <tr><td></td><td><button type="submit" class="btn btn-blue">Đăng ký</button></td></tr>
        </table>
        <p>Bạn đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a></p>
    }
</div>
